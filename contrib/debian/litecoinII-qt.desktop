[Desktop Entry]
Version=1.0
Name=LitecoinII Core
Comment=Connect to the LitecoinII P2P Network
Comment[de]=Verbindung mit dem LitecoinII Peer-to-Peer-Netzwerk herstellen
Comment[es]=Conectar a la red P2P de LitecoinII
Comment[fr]=Se connecter au réseau pair à pair LitecoinII
GenericName=Cryptocurrency Wallet
Exec=litecoinII-qt %u
Terminal=false
Type=Application
Icon=litecoinII128
MimeType=x-scheme-handler/litecoinII;
Categories=Office;Finance;Network;
Keywords=litecoinII;crypto;cryptocurrency;wallet;blockchain;
StartupNotify=true
StartupWMClass=LitecoinII-qt
